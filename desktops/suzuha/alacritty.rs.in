
// Alacritty: un archivo que alacritty.toml importa, y que la terminal recarga sola
fn alacritty_config(theme: &Theme, colors: &Colors) -> String {
    let names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"];

    let mut text = String::from("# generated by amane, do not edit\n");

    text.push_str(&format!(
        "[colors.primary]\nbackground = \"{}\"\nforeground = \"{}\"\n\n",
        hex(colors.background),
        hex(colors.foreground)
    ));
    text.push_str(&format!(
        "[colors.cursor]\ntext = \"{}\"\ncursor = \"{}\"\n\n",
        hex(theme.on_accent),
        hex(colors.cursor)
    ));
    text.push_str(&format!(
        "[colors.selection]\ntext = \"{}\"\nbackground = \"{}\"\n",
        hex(colors.foreground),
        hex(colors.selection)
    ));

    for (section, offset) in [("normal", 0), ("bright", 8)] {
        text.push_str(&format!("\n[colors.{section}]\n"));

        for (index, name) in names.iter().enumerate() {
            text.push_str(&format!("{name} = \"{}\"\n", hex(colors.ansi[index + offset])));
        }
    }

    text
}
